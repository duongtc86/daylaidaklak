<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Token Management System</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <style>
      :root {
        --primary: #667eea;
        --primary-dark: #5a6fd8;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --dark: #1f2937;
        --light: #f9fafb;
        --gray: #6b7280;
        --border: #e5e7eb;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 20px;
        color: var(--dark);
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        overflow: hidden;
      }

      /* Header */
      .header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 15px;
      }

      .logo i {
        font-size: 2.5rem;
      }

      .logo h1 {
        font-size: 2.2rem;
        font-weight: 700;
      }

      .logo p {
        opacity: 0.9;
        font-size: 1rem;
      }

      .status-badge {
        background: rgba(255, 255, 255, 0.2);
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .status-badge.online {
        background: rgba(16, 185, 129, 0.2);
      }

      /* Main Content */
      .main-content {
        display: grid;
        grid-template-columns: 1fr 2fr;
        min-height: 600px;
      }

      /* Sidebar */
      .sidebar {
        background: var(--light);
        padding: 30px;
        border-right: 1px solid var(--border);
      }

      .sidebar-section {
        margin-bottom: 30px;
      }

      .sidebar-section h3 {
        font-size: 1.2rem;
        margin-bottom: 15px;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .sidebar-section h3 i {
        color: var(--primary);
      }

      .input-group {
        margin-bottom: 15px;
      }

      .input-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: 500;
        color: var(--dark);
      }

      .input-group input {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid var(--border);
        border-radius: 10px;
        font-size: 1rem;
        transition: all 0.3s;
      }

      .input-group input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
      }

      .btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
      }

      .btn-primary {
        background: var(--primary);
        color: white;
      }

      .btn-primary:hover {
        background: var(--primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
      }

      .btn-success {
        background: var(--success);
        color: white;
      }

      .btn-success:hover {
        background: #0da271;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(16, 185, 129, 0.3);
      }

      .btn-warning {
        background: var(--warning);
        color: white;
      }

      .btn-warning:hover {
        background: #e68a09;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(245, 158, 11, 0.3);
      }

      .btn-danger {
        background: var(--danger);
        color: white;
      }

      .btn-danger:hover {
        background: #dc2626;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(239, 68, 68, 0.3);
      }

      .btn-info {
        background: var(--gray);
        color: white;
      }

      .btn-info:hover {
        background: #4b5563;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(107, 114, 128, 0.3);
      }

      /* Content */
      .content {
        padding: 30px;
      }

      .tabs {
        display: flex;
        border-bottom: 2px solid var(--border);
        margin-bottom: 30px;
      }

      .tab {
        padding: 15px 25px;
        background: none;
        border: none;
        font-size: 1rem;
        font-weight: 600;
        color: var(--gray);
        cursor: pointer;
        position: relative;
        transition: all 0.3s;
      }

      .tab:hover {
        color: var(--primary);
      }

      .tab.active {
        color: var(--primary);
      }

      .tab.active::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--primary);
        border-radius: 3px 3px 0 0;
      }

      .tab-content {
        display: none;
      }

      .tab-content.active {
        display: block;
        animation: fadeIn 0.5s;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* API Console */
      .api-console {
        background: var(--light);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
      }

      .api-console h3 {
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .request-info {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        padding: 15px;
        background: white;
        border-radius: 10px;
        border-left: 4px solid var(--primary);
      }

      .method {
        padding: 5px 12px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.9rem;
      }

      .method.get {
        background: #10b981;
        color: white;
      }
      .method.post {
        background: #3b82f6;
        color: white;
      }

      .url {
        font-family: monospace;
        font-size: 1.1rem;
        color: var(--dark);
      }

      .result-area {
        background: white;
        border-radius: 10px;
        padding: 20px;
        min-height: 150px;
        max-height: 300px;
        overflow-y: auto;
        border: 1px solid var(--border);
      }

      .result-area pre {
        white-space: pre-wrap;
        word-break: break-word;
        font-family: "Consolas", monospace;
        font-size: 0.95rem;
        line-height: 1.5;
      }

      /* Tokens Table */
      .tokens-table-container {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
      }

      .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
      }

      .stats {
        display: flex;
        gap: 20px;
      }

      .stat {
        text-align: center;
        padding: 10px 20px;
        background: var(--light);
        border-radius: 10px;
        min-width: 100px;
      }

      .stat .number {
        font-size: 1.8rem;
        font-weight: 700;
        display: block;
      }

      .stat.total .number {
        color: var(--primary);
      }
      .stat.active .number {
        color: var(--success);
      }
      .stat.inactive .number {
        color: var(--danger);
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      thead {
        background: var(--light);
      }

      th {
        padding: 15px;
        text-align: left;
        font-weight: 600;
        color: var(--dark);
        border-bottom: 2px solid var(--border);
      }

      td {
        padding: 15px;
        border-bottom: 1px solid var(--border);
      }

      tr:hover {
        background: #f8fafc;
      }

      .token-cell {
        font-family: monospace;
        font-weight: 600;
        color: var(--dark);
      }

      .status-badge-cell {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
      }

      .status-active {
        background: #d1fae5;
        color: #065f46;
      }

      .status-inactive {
        background: #fee2e2;
        color: #991b1b;
      }

      .action-buttons {
        display: flex;
        gap: 8px;
      }

      .action-btn {
        padding: 6px 12px;
        border: none;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 5px;
      }

      .action-btn.activate {
        background: #d1fae5;
        color: #065f46;
      }

      .action-btn.activate:hover {
        background: #a7f3d0;
      }

      .action-btn.deactivate {
        background: #fee2e2;
        color: #991b1b;
      }

      .action-btn.deactivate:hover {
        background: #fecaca;
      }

      .action-btn.copy {
        background: #dbeafe;
        color: #1e40af;
      }

      .action-btn.copy:hover {
        background: #bfdbfe;
      }

      .action-btn.delete {
        background: #f3f4f6;
        color: var(--gray);
      }

      .action-btn.delete:hover {
        background: #e5e7eb;
      }

      /* Footer */
      .footer {
        text-align: center;
        padding: 25px;
        color: var(--gray);
        font-size: 0.9rem;
        border-top: 1px solid var(--border);
        background: var(--light);
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 10px;
      }

      .footer-links a {
        color: var(--primary);
        text-decoration: none;
        transition: color 0.3s;
      }

      .footer-links a:hover {
        color: var(--primary-dark);
        text-decoration: underline;
      }

      /* Responsive */
      @media (max-width: 992px) {
        .main-content {
          grid-template-columns: 1fr;
        }

        .sidebar {
          border-right: none;
          border-bottom: 1px solid var(--border);
        }
      }

      @media (max-width: 768px) {
        .header {
          flex-direction: column;
          text-align: center;
          gap: 15px;
        }

        .table-header {
          flex-direction: column;
          gap: 20px;
        }

        .stats {
          width: 100%;
          justify-content: space-between;
        }

        table {
          display: block;
          overflow-x: auto;
        }

        .action-buttons {
          flex-wrap: wrap;
        }
      }

      /* Toast Notification */
      .toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        padding: 15px 20px;
        border-radius: 10px;
        color: white;
        font-weight: 500;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        transform: translateY(100px);
        opacity: 0;
        transition: all 0.5s;
        z-index: 1000;
        max-width: 400px;
      }

      .toast.show {
        transform: translateY(0);
        opacity: 1;
      }

      .toast.success {
        background: var(--success);
      }
      .toast.error {
        background: var(--danger);
      }
      .toast.info {
        background: var(--primary);
      }

      /* Loading Spinner */
      .spinner {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: white;
        animation: spin 1s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Header -->
      <div class="header">
        <div class="logo">
          <i class="fas fa-key"></i>
          <div>
            <h1>Token Management System</h1>
            <p>Quản lý và xác thực token với GitHub Gist Backend</p>
          </div>
        </div>
        <div class="status-badge" id="statusBadge">
          <i class="fas fa-circle"></i>
          <span>Đang kiểm tra kết nối...</span>
        </div>
      </div>

      <!-- Main Content -->
      <div class="main-content">
        <!-- Sidebar -->
        <div class="sidebar">
          <div class="sidebar-section">
            <h3><i class="fas fa-bolt"></i> Thao tác nhanh</h3>
            <div class="input-group">
              <label for="tokenInput"><i class="fas fa-key"></i> Token:</label>
              <input
                type="text"
                id="tokenInput"
                placeholder="Nhập hoặc dán token..."
              />
            </div>

            <button class="btn btn-primary" onclick="checkToken()">
              <i class="fas fa-search"></i> Kiểm tra token
            </button>

            <button class="btn btn-success" onclick="activateToken()">
              <i class="fas fa-check-circle"></i> Kích hoạt token
            </button>

            <button class="btn btn-warning" onclick="deactivateToken()">
              <i class="fas fa-times-circle"></i> Hủy kích hoạt
            </button>

            <button class="btn btn-danger" onclick="deleteToken()">
              <i class="fas fa-trash"></i> Xóa token
            </button>
          </div>

          <div class="sidebar-section">
            <h3><i class="fas fa-plus-circle"></i> Tạo mới</h3>
            <button class="btn btn-info" onclick="generateToken()">
              <i class="fas fa-random"></i> Tạo token ngẫu nhiên
            </button>

            <button class="btn btn-info" onclick="clearConsole()">
              <i class="fas fa-broom"></i> Xóa console
            </button>
          </div>

          <div class="sidebar-section">
            <h3><i class="fas fa-database"></i> Database</h3>
            <button class="btn btn-primary" onclick="loadAllTokens()">
              <i class="fas fa-sync-alt"></i> Tải lại danh sách
            </button>

            <button class="btn btn-danger" onclick="resetDatabase()">
              <i class="fas fa-exclamation-triangle"></i> Reset database
            </button>
          </div>
        </div>

        <!-- Content -->
        <div class="content">
          <!-- Tabs -->
          <div class="tabs">
            <button class="tab active" onclick="switchTab('console')">
              <i class="fas fa-terminal"></i> API Console
            </button>
            <button class="tab" onclick="switchTab('tokens')">
              <i class="fas fa-list"></i> Danh sách Tokens
            </button>
          </div>

          <!-- API Console Tab -->
          <div id="consoleTab" class="tab-content active">
            <div class="api-console">
              <h3><i class="fas fa-code"></i> API Console</h3>

              <div class="request-info">
                <span class="method get">GET</span>
                <span class="url" id="currentUrl">/api/login?token=...</span>
              </div>

              <div class="result-area">
                <pre id="consoleOutput">Chọn một thao tác để bắt đầu...</pre>
              </div>
            </div>

            <div class="api-console">
              <h3><i class="fas fa-history"></i> Lịch sử request</h3>
              <div id="requestHistory">
                <p style="color: var(--gray); font-style: italic">
                  Chưa có request nào
                </p>
              </div>
            </div>
          </div>

          <!-- Tokens List Tab -->
          <div id="tokensTab" class="tab-content">
            <div class="tokens-table-container">
              <div class="table-header">
                <h3><i class="fas fa-key"></i> Danh sách Tokens</h3>
                <div class="stats">
                  <div class="stat total">
                    <span class="number" id="totalTokens">0</span>
                    <span>Tổng</span>
                  </div>
                  <div class="stat active">
                    <span class="number" id="activeTokens">0</span>
                    <span>Active</span>
                  </div>
                  <div class="stat inactive">
                    <span class="number" id="inactiveTokens">0</span>
                    <span>Inactive</span>
                  </div>
                </div>
              </div>

              <div id="tokensTableContainer">
                <table>
                  <thead>
                    <tr>
                      <th>Token</th>
                      <th>Trạng thái</th>
                      <th>Ngày tạo</th>
                      <th>Lần cuối truy cập</th>
                      <th>Thao tác</th>
                    </tr>
                  </thead>
                  <tbody id="tokensTableBody">
                    <tr>
                      <td
                        colspan="5"
                        style="
                          text-align: center;
                          padding: 40px;
                          color: var(--gray);
                        "
                      >
                        <i
                          class="fas fa-key"
                          style="
                            font-size: 3rem;
                            margin-bottom: 15px;
                            display: block;
                            opacity: 0.5;
                          "
                        ></i>
                        <p>Chưa có token nào. Hãy tạo token đầu tiên!</p>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>
          Token Management System - Sử dụng GitHub Gist làm database backend
        </p>
        <div class="footer-links">
          <a href="javascript:void(0)" onclick="testAllAPIs()"
            >Test tất cả API</a
          >
          <a href="javascript:void(0)" onclick="checkServerStatus()"
            >Kiểm tra server</a
          >
          <a href="javascript:void(0)" onclick="exportTokens()"
            >Export tokens</a
          >
        </div>
      </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast" id="toast"></div>

    <script>
      // Biến toàn cục
      let currentToken = "";
      let allTokens = [];

      // Khởi tạo
      document.addEventListener("DOMContentLoaded", function () {
        checkServerStatus();
        loadAllTokens();

        // Auto-focus token input
        document.getElementById("tokenInput").focus();

        // Enter key để check token
        document
          .getElementById("tokenInput")
          .addEventListener("keypress", function (e) {
            if (e.key === "Enter") {
              checkToken();
            }
          });
      });

      // Tab switching
      function switchTab(tabName) {
        // Update tabs
        document.querySelectorAll(".tab").forEach((tab) => {
          tab.classList.remove("active");
        });
        document.querySelectorAll(".tab-content").forEach((content) => {
          content.classList.remove("active");
        });

        // Activate selected tab
        event.target.classList.add("active");
        document.getElementById(tabName + "Tab").classList.add("active");
      }

      // Toast notification
      function showToast(message, type = "info", duration = 3000) {
        const toast = document.getElementById("toast");
        toast.textContent = message;
        toast.className = "toast " + type;
        toast.classList.add("show");

        setTimeout(() => {
          toast.classList.remove("show");
        }, duration);
      }

      // Update console output
      function updateConsole(output, url = "") {
        const consoleOutput = document.getElementById("consoleOutput");
        const currentUrl = document.getElementById("currentUrl");

        if (url) {
          currentUrl.textContent = url;
        }

        // Format JSON if needed
        if (
          typeof output === "object" ||
          output.trim().startsWith("{") ||
          output.trim().startsWith("[")
        ) {
          try {
            const parsed = JSON.parse(output);
            output = JSON.stringify(parsed, null, 2);
          } catch (e) {
            // Not JSON, keep as is
          }
        }

        consoleOutput.textContent = output;

        // Add to request history
        addToHistory(url, output);

        // Auto-switch to console tab
        if (
          !document.getElementById("consoleTab").classList.contains("active")
        ) {
          switchTab("console");
        }
      }

      // Add request to history
      function addToHistory(url, response) {
        const historyDiv = document.getElementById("requestHistory");
        const timestamp = new Date().toLocaleTimeString("vi-VN");

        const historyItem = document.createElement("div");
        historyItem.className = "request-info";
        historyItem.innerHTML = `
                <span class="method get">GET</span>
                <span class="url">${url}</span>
                <small style="margin-left: auto; color: var(--gray);">${timestamp}</small>
            `;

        historyItem.onclick = function () {
          updateConsole(response, url);
        };

        // Keep only last 5 items
        const items = historyDiv.querySelectorAll(".request-info");
        if (items.length >= 5) {
          historyDiv.removeChild(items[0]);
        }

        historyDiv.insertBefore(historyItem, historyDiv.firstChild);

        // Remove placeholder if exists
        const placeholder = historyDiv.querySelector("p");
        if (placeholder) {
          historyDiv.removeChild(placeholder);
        }
      }

      // Clear console
      function clearConsole() {
        document.getElementById("consoleOutput").textContent =
          "Console đã được xóa";
        document.getElementById("currentUrl").textContent = "/api/...";
        document.getElementById("requestHistory").innerHTML =
          '<p style="color: var(--gray); font-style: italic;">Chưa có request nào</p>';
      }

      // Get current token from input
      function getCurrentToken() {
        const tokenInput = document.getElementById("tokenInput");
        currentToken = tokenInput.value.trim();

        if (!currentToken) {
          showToast("Vui lòng nhập token!", "error");
          return null;
        }

        return currentToken;
      }

      // API Calls
      async function callAPI(endpoint, params = {}) {
        const queryString = new URLSearchParams(params).toString();
        const url = "/api/" + endpoint + (queryString ? "?" + queryString : "");

        try {
          const response = await fetch(url);
          const result = await response.text();

          updateConsole(result, url);
          return result;
        } catch (error) {
          const errorMsg = `❌ Lỗi: ${error.message}`;
          updateConsole(errorMsg, url);
          showToast("Lỗi kết nối đến server", "error");
          return null;
        }
      }

      // Check token
      async function checkToken() {
        const token = getCurrentToken();
        if (!token) return;

        showToast("Đang kiểm tra token...", "info");
        const result = await callAPI("login", { token: token });

        if (result === "true") {
          showToast("✅ Token đã được kích hoạt", "success");
        } else if (result === "false") {
          showToast("ℹ️ Token mới đã được tạo (chưa kích hoạt)", "info");
        }

        loadAllTokens(); // Refresh list
      }

      // Activate token
      async function activateToken() {
        const token = getCurrentToken();
        if (!token) return;

        showToast("Đang kích hoạt token...", "info");
        const result = await callAPI("activate", { token: token });

        if (result === "true") {
          showToast("✅ Token đã được kích hoạt thành công", "success");
        } else {
          showToast("❌ Token không tồn tại", "error");
        }

        loadAllTokens(); // Refresh list
      }

      // Deactivate token
      async function deactivateToken() {
        const token = getCurrentToken();
        if (!token) return;

        showToast("Đang hủy kích hoạt token...", "info");
        const result = await callAPI("deactivate", { token: token });

        if (result === "true") {
          showToast("✅ Token đã được hủy kích hoạt", "success");
        } else {
          showToast("❌ Token không tồn tại", "error");
        }

        loadAllTokens(); // Refresh list
      }

      // Delete token
      async function deleteToken() {
        const token = getCurrentToken();
        if (!token) return;

        if (!confirm(`Bạn có chắc muốn xóa token "${token}"?`)) {
          return;
        }

        showToast("Đang xóa token...", "info");
        const result = await callAPI("remove", { token: token });

        if (result === "true") {
          showToast("✅ Token đã được xóa", "success");
          document.getElementById("tokenInput").value = "";
        } else {
          showToast("❌ Token không tồn tại", "error");
        }

        loadAllTokens(); // Refresh list
      }

      // Generate random token
      async function generateToken() {
        showToast("Đang tạo token mới...", "info");
        const result = await callAPI("generate");

        try {
          const data = JSON.parse(result);
          if (data.token) {
            document.getElementById("tokenInput").value = data.token;
            showToast(`✅ Đã tạo token: ${data.token}`, "success");
          }
        } catch (e) {
          // Not JSON
        }

        loadAllTokens(); // Refresh list
      }

      // Load all tokens
      async function loadAllTokens() {
        try {
          const response = await fetch("/api/tokens");
          const data = await response.json();

          allTokens = data.tokens || [];

          // Update stats
          document.getElementById("totalTokens").textContent = data.total || 0;
          document.getElementById("activeTokens").textContent =
            data.active || 0;
          document.getElementById("inactiveTokens").textContent =
            data.inactive || 0;

          // Update table
          updateTokensTable(allTokens);
        } catch (error) {
          console.error("Lỗi tải tokens:", error);
        }
      }

      // Update tokens table
      function updateTokensTable(tokens) {
        const tableBody = document.getElementById("tokensTableBody");

        if (!tokens || tokens.length === 0) {
          tableBody.innerHTML = `
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 40px; color: var(--gray);">
                            <i class="fas fa-key" style="font-size: 3rem; margin-bottom: 15px; display: block; opacity: 0.5;"></i>
                            <p>Chưa có token nào. Hãy tạo token đầu tiên!</p>
                        </td>
                    </tr>
                `;
          return;
        }

        let html = "";

        tokens.forEach((token) => {
          const statusClass = token.state ? "status-active" : "status-inactive";
          const statusText = token.state ? "Active" : "Inactive";
          const statusIcon = token.state
            ? "fa-check-circle"
            : "fa-times-circle";

          html += `
                    <tr>
                        <td class="token-cell">
                            <i class="fas fa-key" style="margin-right: 8px; color: var(--gray);"></i>
                            ${token.token}
                        </td>
                        <td>
                            <span class="status-badge-cell ${statusClass}">
                                <i class="fas ${statusIcon}"></i> ${statusText}
                            </span>
                        </td>
                        <td>${token.createdAt || "N/A"}</td>
                        <td>${
                          token.lastAccessed || token.activatedAt || "N/A"
                        }</td>
                        <td>
                            <div class="action-buttons">
                                <button class="action-btn copy" onclick="copyToClipboard('${
                                  token.token
                                }')" title="Copy token">
                                    <i class="fas fa-copy"></i>
                                </button>
                                <button class="action-btn activate" onclick="activateTokenInTable('${
                                  token.token
                                }')" title="Kích hoạt">
                                    <i class="fas fa-check"></i>
                                </button>
                                <button class="action-btn deactivate" onclick="deactivateTokenInTable('${
                                  token.token
                                }')" title="Hủy kích hoạt">
                                    <i class="fas fa-times"></i>
                                </button>
                                <button class="action-btn delete" onclick="deleteTokenInTable('${
                                  token.token
                                }')" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
        });

        tableBody.innerHTML = html;
      }

      // Table actions
      function activateTokenInTable(token) {
        document.getElementById("tokenInput").value = token;
        activateToken();
      }

      function deactivateTokenInTable(token) {
        document.getElementById("tokenInput").value = token;
        deactivateToken();
      }

      function deleteTokenInTable(token) {
        document.getElementById("tokenInput").value = token;
        deleteToken();
      }

      // Copy to clipboard
      function copyToClipboard(text) {
        navigator.clipboard
          .writeText(text)
          .then(() => {
            showToast("✅ Đã copy token vào clipboard", "success");
          })
          .catch((err) => {
            showToast("❌ Lỗi copy token", "error");
          });
      }

      // Reset database
      async function resetDatabase() {
        if (
          !confirm(
            "⚠️ CẢNH BÁO: Bạn có chắc muốn reset toàn bộ database?\nTất cả tokens sẽ bị xóa và không thể khôi phục!"
          )
        ) {
          return;
        }

        showToast("Đang reset database...", "info");
        const result = await callAPI("reset");

        if (result.includes("✅") || result.includes("reset")) {
          showToast("✅ Đã reset toàn bộ database", "success");
          document.getElementById("tokenInput").value = "";
          loadAllTokens();
        }
      }

      // Check server status
      async function checkServerStatus() {
        const statusBadge = document.getElementById("statusBadge");
        const icon = statusBadge.querySelector("i");
        const text = statusBadge.querySelector("span");

        try {
          const response = await fetch("/api/status");
          const data = await response.json();

          if (data.connected) {
            statusBadge.className = "status-badge online";
            icon.className = "fas fa-circle";
            text.textContent = "Đã kết nối GitHub Gist";
            showToast("✅ Kết nối server ổn định", "success", 2000);
          } else {
            statusBadge.className = "status-badge";
            icon.className = "fas fa-circle";
            text.textContent = data.error || "Lỗi kết nối";
          }
        } catch (error) {
          statusBadge.className = "status-badge";
          icon.className = "fas fa-circle";
          text.textContent = "Mất kết nối server";
        }
      }

      // Test all APIs
      async function testAllAPIs() {
        showToast("Đang test tất cả API...", "info");

        const tests = [
          { name: "Tạo token", func: generateToken },
          { name: "Kiểm tra token", func: checkToken },
          { name: "Load danh sách", func: loadAllTokens },
          { name: "Kiểm tra server", func: checkServerStatus },
        ];

        for (const test of tests) {
          await test.func();
          await new Promise((resolve) => setTimeout(resolve, 1000));
        }

        showToast("✅ Đã test tất cả API thành công", "success");
      }

      // Export tokens
      async function exportTokens() {
        try {
          const response = await fetch("/api/tokens");
          const data = await response.json();

          const blob = new Blob([JSON.stringify(data, null, 2)], {
            type: "application/json",
          });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download =
            "tokens-export-" + new Date().toISOString().slice(0, 10) + ".json";
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);

          showToast("✅ Đã export tokens", "success");
        } catch (error) {
          showToast("❌ Lỗi export tokens", "error");
        }
      }
    </script>
  </body>
</html>
